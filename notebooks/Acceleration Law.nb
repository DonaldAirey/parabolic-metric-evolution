Cell[CellGroupData[{

Cell["Type Ia  Supernovae", "Subsection",
 CellChangeTimes->{{3.977140272635559*^9, 3.977140275651041*^9}, 
   3.986828873908062*^9, {3.9868295601964264`*^9, 
   3.9868295831796722`*^9}},ExpressionUUID->"4db888e4-5b96-4218-96db-\
3b2f66f8c579"],

Cell["\<\
We compare the analytic distance--redshift relation with the Pantheon+SH0ES \
Type~Ia supernova dataset using covariance-weighted statistics. The resulting \
Hubble diagram and residuals are shown in Figure 3.\
\>", "Text",
 CellChangeTimes->{{3.9797330644990597`*^9, 3.9797330824095116`*^9}, {
   3.9800222962248516`*^9, 3.980022335860256*^9}, {3.986828884975151*^9, 
   3.986828896228739*^9}, 3.986829327615984*^9, {3.9868295002663403`*^9, 
   3.9868295068104954`*^9}},ExpressionUUID->"b8dbea6e-6108-aa44-8889-\
9c3be919cd21"],

Cell[TextData[{
 "The Pantheon+SH0ES dataset provides observed distance moduli ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["obs", FontSlant -> "Plain"]], "(", 
         StyleBox["z", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\mu_{\\mathrm{obs}}(z)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5b257ef-a0fd-7649-b1d5-ae77842762ba"],
 " calibrated on an absolute scale via the SH0ES determination of the Type Ia \
supernova absolute magnitude. This calibration is applied to both models."
}], "Text",
 CellChangeTimes->{{3.9797331035909824`*^9, 3.9797331913398743`*^9}, {
  3.9800223390643845`*^9, 3.98002241632946*^9}, {3.986829516810829*^9, 
  3.9868295360388737`*^9}, {3.9868295894116135`*^9, 
  3.9868295895360584`*^9}},ExpressionUUID->"1e8df931-5091-ff4c-b884-\
c3b1b0b3cb76"],

Cell[TextData[{
 "Each model predicts ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["D", "TI"], 
          StyleBox["L", "TI"]], "(", 
         StyleBox["z", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$D_L(z)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "746255e5-7855-214a-ba77-415729c8c29a"],
 ", which is mapped to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["th", FontSlant -> "Plain"]], "(", 
         StyleBox["z", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\mu_{\\mathrm{th}}(z)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "120cb728-8013-fa44-98df-8754cd1bdb61"],
 " using the definition of the distance modulus. We compare ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["th", FontSlant -> "Plain"]], "(", 
         StyleBox["z", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\mu_{\\mathrm{th}}(z)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6220de9d-ae3b-434e-aa2c-41051d071650"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["obs", FontSlant -> "Plain"]], "(", 
         StyleBox["z", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\mu_{\\mathrm{obs}}(z)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ca5cf90-0b76-3c46-bcb2-054b22fffdfb"],
 " using the full Pantheon+ STAT+SYS covariance matrix."
}], "Text",
 CellChangeTimes->{{3.979733518938366*^9, 3.9797335357755756`*^9}, {
  3.9797335673613815`*^9, 3.9797335716455097`*^9}, {3.9800224358302*^9, 
  3.9800224584550266`*^9}, {3.9868296109758873`*^9, 3.986829633480152*^9}, {
  3.986829668364826*^9, 
  3.98682966887175*^9}},ExpressionUUID->"e0daf0b6-1afc-8a4f-bd78-\
070d35aa1127"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pmeParams", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"A", "\[Rule]", 
      InterpretationBox[
       StyleBox["\[ScriptCapitalA]",
        FontFamily->"Times"],
       $CellContext`accelerationSI]}], ",", 
     RowBox[{
      InterpretationBox[
       SubscriptBox["V", "0"],
       $CellContext`initialVelocity], "\[Rule]", 
      InterpretationBox[
       SubscriptBox[
        StyleBox["\[ScriptCapitalV]",
         FontFamily->"Times"], "0"],
       $CellContext`initialVelocitySI]}], ",", 
     RowBox[{
      InterpretationBox[
       SubscriptBox["t", "o"],
       $CellContext`observationTime], "\[Rule]", 
      InterpretationBox[
       SubscriptBox[
        StyleBox["\[ScriptT]",
         FontFamily->"Times"], "o"],
       $CellContext`observationTimeSI]}], ",", 
     RowBox[{"pc", "\[Rule]", 
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{"Quantity", "[", 
         RowBox[{"1", ",", "\"\<Parsecs\>\""}], "]"}], 
        ",", "\"\<Meters\>\""}], "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"flrwParams", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      InterpretationBox[
       SubscriptBox["\[CapitalOmega]", "m"],
       $CellContext`massDensity], "\[Rule]", "0.315"}], ",", 
     RowBox[{
      InterpretationBox[
       SubscriptBox["\[CapitalOmega]", "k"],
       $CellContext`curvatureDensity], "\[Rule]", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"flrwParams", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"flrwParams", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         InterpretationBox[
          SubscriptBox["\[CapitalOmega]", "\[Lambda]"],
          $CellContext`lambdaDensity], "\[Rule]", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           InterpretationBox[
            SubscriptBox["\[CapitalOmega]", "m"],
            $CellContext`massDensity], "-", 
           InterpretationBox[
            SubscriptBox["\[CapitalOmega]", "k"],
            $CellContext`curvatureDensity]}], ")"}]}], "/.", 
        "\[VeryThinSpace]", "flrwParams"}], ",", 
       RowBox[{
        InterpretationBox[
         SubscriptBox["H", "0"],
         $CellContext`hubbleConstant], "\[Rule]", 
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Quantity", "[", 
            RowBox[{"67.4", ",", 
             FractionBox["\"\<Kilometers\>\"", 
              RowBox[{"\"\<Seconds\>\"", " ", "\"\<Megaparsecs\>\""}]]}], 
            "]"}], "/.", " ", "flrwParams"}], ",", 
          RowBox[{"1", "/", "\"\<Seconds\>\""}]}], "]"}]}], ",", 
       RowBox[{"pc", "\[Rule]", 
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          RowBox[{"Quantity", "[", 
           RowBox[{"1", ",", "\"\<Parsecs\>\""}], "]"}], 
          ",", "\"\<Meters\>\""}], "]"}]}], ",", 
       RowBox[{"c", "\[Rule]", 
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          RowBox[{"Quantity", "[", "\"\<SpeedOfLight\>\"", "]"}], ",", 
          FractionBox["\"\<Meters\>\"", "\"\<Seconds\>\""]}], "]"}]}]}], 
      "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979296369538599*^9, 3.9792964148985043`*^9}, {
