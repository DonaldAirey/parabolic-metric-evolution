}, Open  ]],

Cell[TextData[{
 "Figure 1. The baryonic mass surface ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "(", 
         RowBox[{
           StyleBox["v", "TI"], ",", 
           StyleBox["r", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$M(v,r)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5dc99f6-d3b6-6d4b-87f4-62f4c0187c33"],
 " is shown as a function of orbital speed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$v$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "285d3e9c-f0d2-4f4a-9b9d-409fb26c1221"],
 " and orbital radius ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$r$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5acee3b7-498a-314e-bb37-f7d44f7d7f4a"],
 " for an illustrative acceleration scale ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         SuperscriptBox["10", "-11"], 
         StyleBox["m", "TI"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "-2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$A = 10^{-11} m s^{-2}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6fd2f66-596b-c24e-a241-1b7ca6ac09f9"],
 ". The red ridge marks the locus ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "max"], "(", 
         StyleBox["v", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$M_{\\max}(v)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7325711d-c20d-4440-9442-70b0c4c7cd6d"],
 " corresponding to the maximum baryonic mass permitted at each orbital \
speed. Galaxies populating this ridge reproduce the baryonic Tully--Fisher \
relation."
}], "Text",
 CellChangeTimes->{{3.9800058728531036`*^9, 3.980005952860935*^9}, {
   3.980006090516197*^9, 3.980006119709055*^9}, {3.9800063426269226`*^9, 
   3.9800063464106216`*^9}, {3.980006718065256*^9, 3.9800067332168217`*^9}, {
   3.981659870041153*^9, 3.981659870184204*^9}, {3.9865602393160763`*^9, 
   3.9865602395061665`*^9}, {3.9865823646354885`*^9, 
   3.9865823996584854`*^9}, {3.9865824321582966`*^9, 3.986582455127445*^9}, {
   3.9865825310225105`*^9, 3.986582642283203*^9}, {3.9865826732213783`*^9, 
   3.986582702653757*^9}, 
   3.986582875872587*^9},ExpressionUUID->"5be7e237-2b1b-7241-9bde-\
9b92a2319a4e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Baryonic Tully--Fisher Relation", "Subsection",
 CellChangeTimes->{{3.975926923007534*^9, 3.9759269671046143`*^9}, 
   3.9759270608007984`*^9, 3.9765672182635574`*^9, 
   3.9865804198203526`*^9},ExpressionUUID->"37d06737-7ae4-4026-a61d-\
d76ad1f7ed3f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "max"], "(", 
         StyleBox["v", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$M_{\\max}(v)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88181bd6-d6f0-5a46-9856-5fe0e872ec76"],
 " defines the scaling ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["v", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$M \\propto v^4$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13f01bc9-a7fc-6c48-b6cb-b076a4303694"],
 ", consistent with the observed baryonic Tully--Fisher relation. The \
normalization of this relation is set by the acceleration scale ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$A$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "214ae725-7912-ac48-a0bb-338fd4b6cc6d"],
 ". A characteristic acceleration scale in galaxy dynamics has previously \
been emphasized in frameworks such as MOND."
}], "Text",
 CellChangeTimes->{{3.986580443860756*^9, 3.9865804573491364`*^9}, {
  3.986580551566828*^9, 
  3.9865805678604546`*^9}},ExpressionUUID->"c32f4787-182f-b74f-8f91-\
ba79daf083a6"],

Cell[TextData[{
 "This parameter is determined empirically by fitting the circular-orbit \
envelope to the SPARC galaxy sample of McGaugh, Lelli and Schombert, using \
the assumptions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalUpsilon]", "\[FivePointedStar]"], 
         "\[LongEqual]", "0.5"}], TraditionalForm], "errors" -> {}, "input" -> 
     "$\\Upsilon_\\star=0.5$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "090fa05c-94f8-1544-b0ab-fd4e22e7d3f0"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["gas", FontSlant -> "Plain"]], "\[LongEqual]", "1.33"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "$f_{\\mathrm{gas}}=1.33$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66a650b6-90ba-9e43-aa84-977f09b976c7"],
 ", zero intrinsic mass-to-light uncertainty, and the quality cut ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Qual", FontSlant -> "Plain"], "\[LessEqual]", "3"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$\\mathrm{Qual}\\leq 3$",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5753233-ca91-f141-a807-b4d8146ba2fd"],
 ". These rotationally supported disk systems are well suited to this \
analysis, as their kinematics closely follow circular-orbit behavior."
}], "Text",
 CellChangeTimes->{{3.986580582861204*^9, 3.9865806413579426`*^9}, {
  3.9865808728601665`*^9, 
  3.9865808736898613`*^9}},ExpressionUUID->"f74d747d-863b-fb4b-8788-\
3de4d394a5ad"],

Cell[TextData[{
 "For each galaxy the rotation curve provides an asymptotic circular velocity \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$v$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63717763-d44b-df48-abf6-f4978d82e664"],
 ", while the baryonic mass ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["b", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$M_b$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47bd873b-326e-144e-b7dc-0cb6362c30c6"],
 " is computed as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["b", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[CapitalUpsilon]", "\[FivePointedStar]"], 
         SubscriptBox[
          StyleBox["L", "TI"], "3.6"], "+", 
         SubscriptBox[
          StyleBox["f", "TI"], 
          RowBox[{
            StyleBox["g", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["s", "TI"]}]], " ", 
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["HI", FontSlant -> "Plain"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$M_b=\\Upsilon_\\star L_{3.6}+f_{gas}\\,M_{\\mathrm{HI}}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7994692-0510-7143-8432-41597ca0a58b"],
 ". The value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$A$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "33ba3a42-975b-e646-88a1-713e5dbc0248"],
 " is determined by minimizing the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Chi]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\chi^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6d6894a7-6eac-b648-a0dc-6b35099415be"],
 " statistic between the theoretical envelope and the observed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["M", "TI"], 
            StyleBox["b", "TI"]], ",", 
           StyleBox["v", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$(M_b,v)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6ed2cb4-f49b-404b-b1ef-0e5aceccd592"],
 " pairs."
}], "Text",
 CellChangeTimes->{{3.986580870003746*^9, 
  3.9865809225051727`*^9}},ExpressionUUID->"b85da5ac-6750-0e44-be81-\
ad026bd5da4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "tapURL", 
   "=", "\"\<https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync\>\""}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"adql", "=", "\"\<SELECT * FROM \\\"J/AJ/152/157/table1\\\"\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"raw", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"URLBuild", "[", 
      RowBox[{"tapURL", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<request\>\"", "->", "\"\<doQuery\>\""}], ",", 
         RowBox[{"\"\<lang\>\"", "->", "\"\<adql\>\""}], ",", 
         RowBox[{"\"\<format\>\"", "->", "\"\<csv\>\""}], ",", 
         RowBox[{"\"\<query\>\"", "->", "adql"}]}], "|>"}]}], "]"}], 
     ",", "\"\<CSV\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"header", "=", 
   RowBox[{"First", "[", "raw", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rows", "=", 
   RowBox[{"Rest", "[", "raw", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"upsStar", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fracUpsErr", "=", "0.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gasFactor", "=", "1.33"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxQual", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"column", "=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"header", "->", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "header", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"get", "[", 
    RowBox[{"row_", ",", "key_"}], "]"}], ":=", 
   RowBox[{"row", "[", 
    RowBox[{"[", 
     RowBox[{"column", "[", "key", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"baryonicMass", "[", "row_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l36", "=", 
        RowBox[{"N", "@", 
         RowBox[{"get", "[", 
          RowBox[{"row", ",", "\"\<L3_6\>\""}], "]"}]}]}], ",", 
       RowBox[{"mhi", "=", 
        RowBox[{"N", "@", 
         RowBox[{"get", "[", 
          RowBox[{"row", ",", "\"\<MHI\>\""}], "]"}]}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"upsStar", "*", "l36"}], "+", 
      RowBox[{"gasFactor", "*", "mhi"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"massError", "[", "row_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l36", "=", 
        RowBox[{"N", "@", 
         RowBox[{"get", "[", 
          RowBox[{"row", ",", "\"\<L3_6\>\""}], "]"}]}]}], ",", 
       RowBox[{"el36", "=", 
        RowBox[{"N", "@", 
         RowBox[{"get", "[", 
          RowBox[{"row", ",", "\"\<e_L3_6\>\""}], "]"}]}]}], ",", 
       RowBox[{"mhi", "=", 
        RowBox[{"N", "@", 
         RowBox[{"get", "[", 
          RowBox[{"row", ",", "\"\<MHI\>\""}], "]"}]}]}], ",", 
       RowBox[{"dist", "=", 
        RowBox[{"N", "@", 
         RowBox[{"get", "[", 
          RowBox[{"row", ",", "\"\<Dist\>\""}], "]"}]}]}], ",", 
       RowBox[{"edist", "=", 
        RowBox[{"N", "@", 
         RowBox[{"get", "[", 
          RowBox[{"row", ",", "\"\<e_Dist\>\""}], "]"}]}]}], ",", "fracDist", 
       ",", "eStarPhot", ",", "eStarML", ",", "eGasDist", ",", "eStarDist"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"fracDist", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"dist", ">", "0"}], ",", 
         RowBox[{"edist", "/", "dist"}], ",", "0.0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eStarPhot", "=", 
       RowBox[{"upsStar", "*", "el36"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eStarML", "=", 
       RowBox[{"fracUpsErr", "*", "upsStar", "*", "l36"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eStarDist", "=", 
       RowBox[{"2", "*", "fracDist", "*", 
        RowBox[{"(", 
         RowBox[{"upsStar", "*", "l36"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eGasDist", "=", 
       RowBox[{"2", "*", "fracDist", "*", 
        RowBox[{"(", 
         RowBox[{"gasFactor", "*", "mhi"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"eStarPhot", "^", "2"}], "+", 
        RowBox[{"eStarML", "^", "2"}], "+", 
        RowBox[{"eStarDist", "^", "2"}], "+", 
        RowBox[{"eGasDist", "^", "2"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vflat", "[", "row_", "]"}], ":=", 
   RowBox[{"N", "@", 
    RowBox[{"get", "[", 
     RowBox[{"row", ",", "\"\<Vflat\>\""}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vflatError", "[", "row_", "]"}], ":=", 
   RowBox[{"N", "@", 
    RowBox[{"get", "[", 
     RowBox[{"row", ",", "\"\<e_Vflat\>\""}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"validRowQ", "[", "row_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{"vflat", "[", "row", "]"}]}], ",", 
       RowBox[{"ev", "=", 
        RowBox[{"vflatError", "[", "row", "]"}]}], ",", 
       RowBox[{"q", "=", 
        RowBox[{"get", "[", 
         RowBox[{"row", ",", "\"\<Qual\>\""}], "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"NumericQ", "[", "v", "]"}], "&&", 
      RowBox[{"NumericQ", "[", "ev", "]"}], "&&", 
      RowBox[{"v", ">", "0"}], "&&", 
      RowBox[{"ev", ">=", "0"}], "&&", 
      RowBox[{"q", "<=", "maxQual"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"goodRows", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"rows", ",", "validRowQ"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"btfrData", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"baryonicMass", "[", "#", "]"}], ",", 
        RowBox[{"vflat", "[", "#", "]"}], ",", 
        RowBox[{"massError", "[", "#", "]"}], ",", 
        RowBox[{"vflatError", "[", "#", "]"}]}], "}"}], "&"}], ")"}], "/@", 
    "goodRows"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97801177737241*^9, 3.97801177737241*^9}, {
   3.9780121227661743`*^9, 3.978012157192642*^9}, {3.978012192618908*^9, 
   3.9780123293430786`*^9}, {3.978012369975727*^9, 3.978012415065012*^9}, {
   3.9780125121592007`*^9, 3.9780125138980827`*^9}, {3.97801279333193*^9, 
   3.978012794997755*^9}, {3.9780132574313107`*^9, 3.9780132617965603`*^9}, {
   3.9780134743131714`*^9, 3.9780134861440887`*^9}, {3.9780138607517014`*^9, 
   3.978013906180046*^9}, {3.97801414500585*^9, 3.978014160510933*^9}, {
   3.978014290172779*^9, 3.9780142954945545`*^9}, {3.978014567300741*^9, 
   3.9780145902666683`*^9}, 3.9780155531457024`*^9, 3.978015660342182*^9, {
   3.9780163181665993`*^9, 3.978016336866989*^9}, 3.978016428180126*^9, {
   3.97801655230682*^9, 3.978016554961836*^9}, {3.978016854871294*^9, 
   3.978016897156933*^9}, 3.9780169805943623`*^9, {3.97802188316346*^9, 
   3.9780218852107544`*^9}, {3.978022081992628*^9, 3.9780220838764744`*^9}, {
   3.978022118495676*^9, 3.978022135127121*^9}, {3.9780223264236774`*^9, 
   3.9780223306882477`*^9}, {3.978022395052719*^9, 3.9780223979592304`*^9}, {
   3.978022620549595*^9, 3.9780227009966564`*^9}, 3.97802317400782*^9, {
   3.9780238168622627`*^9, 3.978023856115305*^9}, {3.9780240026749973`*^9, 
   3.9780240156518974`*^9}, {3.9780273427718563`*^9, 
   3.9780273526931725`*^9}, {3.978027468739151*^9, 3.9780274912514668`*^9}, {
   3.978027671380373*^9, 3.978027694132328*^9}, {3.9780332856797066`*^9, 
   3.978033315412407*^9}, 3.9780335709970036`*^9, {3.978033660520262*^9, 
   3.978033668591078*^9}, 3.978033837746231*^9, 3.9780342030413*^9, {
   3.9780343373704453`*^9, 3.9780343515023956`*^9}, 3.978034395946409*^9, {
   3.978034522111988*^9, 3.9780345336484737`*^9}, {3.978034584096138*^9, 
   3.9780347018040276`*^9}, {3.978034764117876*^9, 3.978034783107849*^9}, {
   3.9780348230440693`*^9, 3.978034847729435*^9}, {3.9780351126494617`*^9, 
   3.978035179838728*^9}, {3.9780352551348248`*^9, 3.9780352587931175`*^9}, {
   3.9781017704009895`*^9, 3.9781018368217945`*^9}, 3.978101886025263*^9, 
   3.978107449392399*^9, {3.978107538074028*^9, 3.9781075456768856`*^9}, {
   3.9781076951985207`*^9, 3.978107696526741*^9}, {3.9781079264946327`*^9, 
   3.9781079617543144`*^9}, {3.978108066153263*^9, 3.978108067550226*^9}, 
   3.9781081420531464`*^9, {3.9781084004766903`*^9, 3.9781084148182735`*^9}, {
   3.9781084668474903`*^9, 3.978108469371935*^9}, {3.9781085173374634`*^9, 
   3.9781085240225735`*^9}, {3.9781098509406033`*^9, 3.9781098746615047`*^9}, 
   3.978113521864744*^9, {3.9781144277006416`*^9, 3.978114508706337*^9}, {
