   3.9769080250286427`*^9}, 3.9770605461290054`*^9, {3.977225377189287*^9, 
   3.97722537774123*^9}, {3.9790503410992603`*^9, 3.979050341881859*^9}, 
   3.979671470943638*^9, {3.980011804728863*^9, 3.9800118050474777`*^9}, {
   3.9800122573677273`*^9, 3.980012276689398*^9}, {3.980012369244747*^9, 
   3.9800123717656384`*^9}, {3.9800125964760056`*^9, 3.980012596579132*^9}, {
   3.98001263550218*^9, 3.9800126362062607`*^9}, 3.9816598787058296`*^9, 
   3.986581948613758*^9, 3.986582049026802*^9, {3.9865821748926735`*^9, 
   3.986582200033827*^9}},ExpressionUUID->"aaeac20c-f2e6-3042-a1cd-\
