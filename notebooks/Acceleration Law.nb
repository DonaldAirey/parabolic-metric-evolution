      RowBox[{
       RowBox[{"-", "2"}], ",", 
       RowBox[{"-", "3"}], ",", "1"}], "}"}]}], ",", 
    RowBox[{"ViewVertical", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ",", 
    RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9777665652066307`*^9, 3.977766609633663*^9}, {
