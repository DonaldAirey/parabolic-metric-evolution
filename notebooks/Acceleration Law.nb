Cell[CellGroupData[{

Cell["Distance-Redshift Relation", "Subsection",
 CellChangeTimes->{{3.986632900844574*^9, 
  3.9866329223946*^9}},ExpressionUUID->"715f3e97-176e-4c24-891e-44659ec43c65"],

Cell["\<\
We consider a phenomenological analytic form for the comoving distance,\
\>", "Text",
 CellChangeTimes->{
  3.9866334788311386`*^9},ExpressionUUID->"b7c7c13f-a111-8340-bea3-\
90ee8ebbc515"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   InterpretationBox[
    SubscriptBox["D", "C"],
    $CellContext`pmeComovingDistance], "[", "z_", "]"}], "=", 
  FractionBox[
   RowBox[{
    InterpretationBox[
     SubscriptBox["t", "o"],
     $CellContext`observationTime], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       InterpretationBox[
        SubscriptBox["V", "0"],
        $CellContext`initialVelocity]}], "-", 
      RowBox[{"A", " ", 
       InterpretationBox[
        SubscriptBox["t", "o"],
        $CellContext`observationTime]}]}], ")"}], " ", "z"}], 
   RowBox[{"2", "+", "z"}]]}]], "Input",
 CellChangeTimes->{{3.986634173090811*^9, 3.986634184147867*^9}, {
  3.9866342526215515`*^9, 3.986634262070467*^9}, {3.9866646543231697`*^9, 
  3.9866646605358067`*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"f3e3cf52-3568-4bf6-9d2d-b5744c0ef0d7"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   InterpretationBox[
    SubscriptBox["t", "o"],
    $CellContext`observationTime], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", 
      InterpretationBox[
       SubscriptBox["V", "0"],
       $CellContext`initialVelocity]}], "-", 
     RowBox[{"A", " ", 
      InterpretationBox[
       SubscriptBox["t", "o"],
       $CellContext`observationTime]}]}], ")"}], " ", "z"}], 
  RowBox[{"2", "+", "z"}]]], "Output",
 CellChangeTimes->{3.9868208393377934`*^9, 3.9891498871640987`*^9},
 CellLabel->
  "Out[119]=",ExpressionUUID->"4edc73b8-8978-ef40-a5de-db3a12f32a03"]
}, Open  ]],

Cell["The luminosity distance follows as", "Text",
 CellChangeTimes->{
  3.9866343025431385`*^9},ExpressionUUID->"3071a76a-bc35-0547-97e4-\
5c5ba98af575"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   InterpretationBox[
    SubscriptBox["D", "L"],
    $CellContext`pmeLuminousDistance], "[", "z_", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", "z"}], ")"}], " ", 
   RowBox[{
    InterpretationBox[
     SubscriptBox["D", "C"],
     $CellContext`pmeComovingDistance], "[", "z", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.986634173090811*^9, 3.986634184147867*^9}, {
  3.9866342526215515`*^9, 3.986634262070467*^9}, {3.9866343286239357`*^9, 
  3.986634351903919*^9}, {3.9866615424340916`*^9, 3.986661572096651*^9}, {
  3.986664664109392*^9, 3.9866646668516235`*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"a3eaa6a2-ce58-418f-99e4-5b1e2826e2c4"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   InterpretationBox[
    SubscriptBox["t", "o"],
    $CellContext`observationTime], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", 
      InterpretationBox[
       SubscriptBox["V", "0"],
       $CellContext`initialVelocity]}], "-", 
     RowBox[{"A", " ", 
      InterpretationBox[
       SubscriptBox["t", "o"],
       $CellContext`observationTime]}]}], ")"}], " ", "z", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "z"}], ")"}]}], 
  RowBox[{"2", "+", "z"}]]], "Output",
 CellChangeTimes->{3.9868208394023876`*^9, 3.989149887173731*^9},
 CellLabel->
  "Out[120]=",ExpressionUUID->"0e350a13-1cf7-e343-a9ea-5eece799be53"]
}, Open  ]],

Cell["\<\
This analytic form differs from the standard FLRW integral representation and \
provides an alternative distance-redshift relation for comparison with \
observations.\
\>", "Text",
 CellChangeTimes->{{3.9866343642189026`*^9, 
  3.986634372556856*^9}},ExpressionUUID->"2e4922dc-38ce-ed45-bb23-\
72e639556725"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Distance Modulus", "Subsection",
 CellChangeTimes->{{3.9756150200057755`*^9, 3.9756150225197773`*^9}, 
   3.977249452073448*^9},ExpressionUUID->"7c1b0f2a-47a8-44a7-9bcd-\
33b9ab2ba1c4"],

Cell["\<\
Type-Ia supernova observations are reported in terms of the distance modulus, \
which relates the observed luminosity distance to the measured brightness of \
each supernova,\
\>", "Text",
 CellChangeTimes->{{3.9756150572188587`*^9, 3.9756150802758617`*^9}, {
  3.977138409634054*^9, 3.977138456663418*^9}, {3.9800156176111813`*^9, 
  3.980015621991213*^9}, {3.9866348202360477`*^9, 
  3.9866348361241055`*^9}},ExpressionUUID->"a8cd407a-3b72-5340-bdcf-\
a01a094d8e4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    InterpretationBox[
     SubscriptBox["\[Mu]", "pme"],
     $CellContext`pmePrediction], "[", 
    RowBox[{"z_", "?", "NumberQ"}], "]"}], "=", 
   RowBox[{"5", " ", 
    RowBox[{"Log10", "[", 
     FractionBox[
      RowBox[{
       InterpretationBox[
        SubscriptBox["D", "L"],
        $CellContext`pmeLuminousDistance], "[", "z", "]"}], 
      RowBox[{"10", " ", "pc"}]], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.97567493311989*^9, 3.975674991439678*^9}, {
   3.975675040370949*^9, 3.975675042736862*^9}, {3.9757659652786617`*^9, 
   3.975765999165697*^9}, {3.9757752472219677`*^9, 3.9757752521546288`*^9}, {
   3.9757756057848167`*^9, 3.9757756160746517`*^9}, 3.975776018444931*^9, 
   3.975779018113083*^9, {3.9761356599507656`*^9, 3.976135666751663*^9}, {
   3.9764778418052235`*^9, 3.976477865214346*^9}, {3.976654517732378*^9, 
   3.976654519994087*^9}, {3.976703028253977*^9, 3.9767030495975666`*^9}, {
   3.9767034728967323`*^9, 3.9767035427841606`*^9}, {3.9769895440475883`*^9, 
   3.976989550736824*^9}, {3.976990421533886*^9, 3.9769904263619156`*^9}, 
   3.9770441282243767`*^9, {3.9773432163172894`*^9, 3.977343217964386*^9}, {
   3.9788939266068115`*^9, 3.9788939429008083`*^9}, {3.9788971705561047`*^9, 
   3.978897191192417*^9}, {3.9790731024983807`*^9, 3.9790731152113876`*^9}, {
   3.979073227922785*^9, 3.9790732436817265`*^9}, 3.9790733333985844`*^9, {
   3.979150807627651*^9, 3.9791508453881626`*^9}, {3.979203147721056*^9, 
   3.9792031504890327`*^9}, 3.9792033262449512`*^9, {3.9792226417463875`*^9, 
   3.979222646059801*^9}, {3.9792231055673275`*^9, 3.9792231072576237`*^9}, {
   3.979227056550789*^9, 3.979227072491892*^9}, 3.979234471671442*^9, 
   3.979235300437216*^9, {3.979560873034767*^9, 3.97956087420574*^9}, {
   3.979590275480562*^9, 3.9795902768515415`*^9}, {3.9866646713420944`*^9, 
   3.98666467512875*^9}, {3.9866728607580853`*^9, 3.9866728611962414`*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"daca915a-f143-934d-80b6-71d945be75fd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Kinematic Parameters", "Subsection",
 CellChangeTimes->{{3.986672821506033*^9, 
  3.9866728355956593`*^9}},ExpressionUUID->"c31b2ba6-ab37-47f4-8a85-\
407bc8a6fe55"],

Cell["\<\
We treat the parameters in the analytic distance--redshift relation as \
kinematic quantities that set the temporal, velocity, and acceleration scales \
of the model, without assuming an underlying dynamical theory.\
\>", "Text",
 CellChangeTimes->{{3.986672848306509*^9, 
  3.9866728510659657`*^9}},ExpressionUUID->"2407cec9-43b0-d242-8231-\
1936b9404b6d"],

Cell["\<\
A boundary condition is imposed at the observation epoch by requiring that \
the parameter combination reproduce the locally measured speed of light,\
\>", "Text",
 CellChangeTimes->{
  3.9866728646258583`*^9},ExpressionUUID->"0c8efa92-5257-1143-bd47-\
415b879f33f8"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["c", "TI"], "\[LongEqual]", 
       SubscriptBox[
        StyleBox["V", "TI"], "0"], "-", 
       StyleBox["A", "TI"], 
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["o", "TI"]], "."}], TraditionalForm], "errors" -> {}, 
   "input" -> "c = V_ 0 - A t_o .\n\\label {eq : co_definition}", "state" -> 
   "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormula",
 CellChangeTimes->{{3.9866728920942936`*^9, 
  3.9866729078956356`*^9}},ExpressionUUID->"034e001f-3bb0-e54d-aa4b-\
bc38b0767dea"],

Cell[TextData[{
 "This condition fixes the integration constant ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "$V_0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6f266e35-6bee-1741-b050-d1cea8e0aa6c"],
 " in the analytic distance relation without attributing to it a direct \
physical interpretation as a signal velocity. Rearranging,"
}], "Text",
 CellChangeTimes->{3.9866730305463047`*^9, 
  3.9866731123896217`*^9},ExpressionUUID->"26a41184-860b-5e4b-ad07-\
77e30b9531c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"velocity", "=", 
   RowBox[{"c", "+", 
    RowBox[{"A", " ", 
     InterpretationBox[
      SubscriptBox["t", "o"],
      $CellContext`observationTime]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.976655346344805*^9, 3.976655387457781*^9}, {
   3.9766554426250362`*^9, 3.9766554522083683`*^9}, {3.9766563500706463`*^9, 
   3.9766563511629086`*^9}, 3.97665659177771*^9, 3.9767026035427017`*^9, {
   3.9767029132598114`*^9, 3.9767029812680454`*^9}, {3.9767035952541847`*^9, 
   3.9767036366311073`*^9}, 3.9767050780787125`*^9, {3.9767058126444683`*^9, 
   3.976705856138441*^9}, 3.9767303970650024`*^9, 3.9767895620948753`*^9, {
   3.9767977461518307`*^9, 3.9767977514710407`*^9}, {3.976800573891983*^9, 
   3.976800581158655*^9}, {3.976829471303879*^9, 3.976829474799244*^9}, 
   3.97690017842774*^9, {3.976900825068634*^9, 3.976900860740717*^9}, {
   3.9769009132915745`*^9, 3.9769009732032337`*^9}, 3.9769019268575745`*^9, {
   3.9769019774186115`*^9, 3.9769020042152996`*^9}, {3.9769123058149433`*^9, 
   3.976912307981268*^9}, 3.977568615757782*^9, {3.977568844304741*^9, 
   3.9775688458888664`*^9}, {3.977569562957918*^9, 3.977569599143881*^9}, 
   3.9775698226207123`*^9, {3.978892045402359*^9, 3.9788920727662296`*^9}, {
   3.9788922983442993`*^9, 3.9788923039190216`*^9}, 3.9788936329993095`*^9, 
   3.9788989185349655`*^9, {3.9788990581551895`*^9, 3.9788990772784653`*^9}, {
   3.9788996732004795`*^9, 3.9788996763575096`*^9}, {3.978899784567589*^9, 
   3.9788998037884007`*^9}, {3.9790549044557457`*^9, 
   3.9790549337317524`*^9}, {3.9790550465164604`*^9, 
   3.9790550475243263`*^9}, {3.979061818253153*^9, 3.979061831903414*^9}, {
   3.97906282230266*^9, 3.979062826014471*^9}, 3.979071821207487*^9, {
   3.979227225633293*^9, 3.979227226688341*^9}, {3.979235531945286*^9, 
   3.9792355329424744`*^9}, {3.9792428652858696`*^9, 3.979243025308079*^9}, {
   3.979243276895878*^9, 3.979243289712496*^9}, {3.9792447116040745`*^9, 
   3.9792447123631096`*^9}, {3.979244893234915*^9, 3.9792448982804794`*^9}, 
   3.9815427008039856`*^9, {3.9868196770730247`*^9, 3.986819685035925*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"9ccc5f5c-8716-5946-9b30-13b15c858955"],

Cell[TextData[{
 "With the acceleration scale ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$A$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc4875e6-a7b7-3f4e-bd23-b95b7297d68d"],
 " determined from the baryonic Tully--Fisher analysis, the \
Cepheid-calibrated Pantheon+ subset is used to determine the temporal scale ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$t_o$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e33478db-db45-b54d-966b-08ea8722dc2f"],
 ", while velocity scale ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "$V_0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "944362b9-7221-a345-93a1-9ad6965043ca"],
 " is fixed algebraically by the equation above. The calibration therefore \
involves a single free parameter, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$t_o$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ffcc8de-cbff-eb44-931f-b1de013ad223"],
 "."
}], "Text",
 CellChangeTimes->{{3.9866732885793667`*^9, 
  3.98667335653281*^9}},ExpressionUUID->"9564e252-2078-f14f-8b97-\
c8517a6106aa"],

Cell[TextData[{
 "For each candidate value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$t_o$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0420f78c-498d-e14b-b383-f29ff14a793e"],
 ", theoretical distance moduli ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["th", FontSlant -> "Plain"]], "(", 
         StyleBox["z", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\mu_{\\mathrm{th}}(z)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "019ed523-f638-9a4e-8817-e29008c4dbaf"],
 " are evaluated at the calibration-set redshifts and compared with the \
observed values ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["obs", FontSlant -> "Plain"]], "(", 
         StyleBox["z", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\mu_{\\mathrm{obs}}(z)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a4626f0-7c81-6c4b-ab03-288d3e1afa14"],
 ", defining the residual vector"
}], "Text",
 CellChangeTimes->{{3.9866733886885014`*^9, 
  3.9866734104114685`*^9}},ExpressionUUID->"79cf12c4-2cd1-014b-9bd6-\
a59919ae35e4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Mu]", 
          StyleBox["obs", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["z", "TI"], 
            StyleBox["i", "TI"]], ")"}], "-", 
         SubscriptBox["\[Mu]", 
          StyleBox["th", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["z", "TI"], 
            StyleBox["i", "TI"]], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "$r_i = \\mu_{\\mathrm{obs}}(z_i) - \\mu_{\\mathrm{th}}(z_i)$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], "."}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.9866734377988396`*^9, 
  3.986673466328106*^9}},ExpressionUUID->"9561dbf3-4745-b043-bdf0-\
019448c6ba50"],

Cell[TextData[{
 "The temporal scale ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$t_o$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5afe2963-7155-7d41-a09a-d2fc5b34a94f"],
 " is then determined by minimizing the covariance-weighted ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Chi]", "2"], TraditionalForm], "errors" -> {}, 
     "input" -> "$\\chi^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "291c303d-5d0c-5749-9537-adc5ec307801"],
 " statistic"
}], "Text",
 CellChangeTimes->{{3.9866734805582333`*^9, 3.9866734860638027`*^9}, {
  3.9868241113188725`*^9, 
  3.986824117723543*^9}},ExpressionUUID->"730f918d-13b1-f649-88f7-\
4dfcc31541ee"],

Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox["\[Chi]", "2"], "\[LongEqual]", 
        SuperscriptBox[
         StyleBox["r", "TI"], 
         StyleBox["T", FontSlant -> "Plain"]], 
        SuperscriptBox[
         StyleBox["C", "TI"], "-1"], 
        StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "\\chi^2 = r^{\\mathrm T} C^{-1} r", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.9866735020400047`*^9, 
  3.98667351366807*^9}},ExpressionUUID->"76846e5c-213a-4c46-a273-\
087a19d5962f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["C", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$C$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41c1769a-1ce5-ed4f-8ad1-52c4b1b19140"],
 " is the full Pantheon+ STAT+SYS covariance matrix. The resulting best-fit \
value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["o", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$t_o$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "343e2962-db59-c340-9cf1-ea604b257f25"],
 " determines ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "$V_0$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9274c2d3-5240-3644-8f8c-89916c9e8464"],
 ", completing the kinematic parameter set. The resulting parameters are \
listed in Table 1."
}], "Text",
 CellChangeTimes->{{3.9866735276191826`*^9, 
  3.986673571152111*^9}},ExpressionUUID->"534ecf20-8b1a-a549-aa2b-\
ed1a7d6d59a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "pantheonDirectory", 
   "=", "\"\<https://github.com/PantheonPlusSH0ES/DataRelease/raw/refs/heads/\
main/Pantheon+_Data/4_DISTANCES_AND_COVAR/\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dataUrl", "=", 
