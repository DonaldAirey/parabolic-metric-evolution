Cell[TextData[{
 "The observed galaxies follow the predicted ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["v", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$M\\propto v^4$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd6464ad-dd7c-9349-bbde-f5b55ce0939f"],
 " scaling, as shown in Figure 2. The baryonic Tully--Fisher relation follows \
from the constant acceleration scale."
}], "Text",
 CellChangeTimes->{{3.9865809989062405`*^9, 3.9865810067534046`*^9}, {
  3.9865818130686836`*^9, 
  3.986581819220989*^9}},ExpressionUUID->"fd47eb6e-aedc-3942-b090-\
03d69d502063"],

