Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"G", "\[Rule]", 
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{"Quantity", "[", "\"\<GravitationalConstant\>\"", "]"}], ",", 
        FractionBox[
         SuperscriptBox["\"\<Meters\>\"", "3"], 
         RowBox[{"\"\<Kilograms\>\"", " ", 
          SuperscriptBox["\"\<Seconds\>\"", "2"]}]]}], "]"}]}], ",", 
     RowBox[{"A", "\[Rule]", 
      RowBox[{"Quantity", "[", 
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["10", "11"]], ",", 
        FractionBox["\"\<Meters\>\"", 
         SuperscriptBox["\"\<Seconds\>\"", "2"]]}], "]"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"massSurface", "[", 
    RowBox[{"v_", ",", "r_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"ConditionalExpression", "[", 
     RowBox[{
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{"M", "[", 
         RowBox[{"v", ",", "r"}], "]"}], ",", "\"\<SolarMass\>\""}], "]"}], ",", 
      RowBox[{
       RowBox[{"QuantityMagnitude", "[", 
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          RowBox[{
           SuperscriptBox["v", "2"], "-", 
           RowBox[{"A", " ", "r"}]}], ",", 
          FractionBox[
           SuperscriptBox["\"\<Meters\>\"", "2"], 
           SuperscriptBox["\"\<Seconds\>\"", "2"]]}], "]"}], "]"}], ">", 
       "0"}]}], "]"}], "/.", "\[VeryThinSpace]", "params"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"massScale", "=", 
   FractionBox["1", 
    RowBox[{"Quantity", "[", 
     RowBox[{
      SuperscriptBox["10", "9"], ",", "\"\<SolarMass\>\""}], "]"}]]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fundamentalPlane", "=", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"UnitConvert", "[", 
       RowBox[{
        RowBox[{"massSurface", "[", 
         RowBox[{
          RowBox[{"Quantity", "[", 
           RowBox[{"v", ",", 
            FractionBox["\"\<Kilometers\>\"", "\"\<Seconds\>\""]}], "]"}], ",", 
          RowBox[{"Quantity", "[", 
           RowBox[{"r", ",", "\"\<Kiloparsecs\>\""}], "]"}]}], "]"}], 
        ",", "\"\<SolarMass\>\""}], "]"}], " ", "massScale"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "0", ",", "100"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "30"}], "}"}], ",", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<speed (km \!\(\*SuperscriptBox[\(s\), \(-1\)]\))\>\"", 
        ",", "\"\<radius (kpc)\>\"", 
        ",", "\"\<mass (\!\(\*SuperscriptBox[\(10\), \(9\)]\) \
\!\(\*SubscriptBox[\(M\), \(\[Sun]\)]\))\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"GrayLevel", "[", "0.5", "]"}], "]"}]}], ",", 
     RowBox[{"MeshStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"GrayLevel", "[", "0.3", "]"}], "]"}]}], ",", 
     RowBox[{"Lighting", "->", "\"\<Neutral\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maximumMassCurve", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v", ",", 
        RowBox[{"QuantityMagnitude", "[", 
         RowBox[{"UnitConvert", "[", 
          RowBox[{
           RowBox[{
            InterpretationBox[
             SubscriptBox["r", "max"],
             $CellContext`maximumRadius], "[", 
            RowBox[{"Quantity", "[", 
             RowBox[{"v", ",", 
              FractionBox["\"\<Kilometers\>\"", "\"\<Seconds\>\""]}], "]"}], 
            "]"}], ",", "\"\<Kiloparsecs\>\""}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"UnitConvert", "[", 
          RowBox[{
           RowBox[{
            InterpretationBox[
             SubscriptBox["M", "max"],
             $CellContext`maximumMass], "[", 
            RowBox[{"Quantity", "[", 
             RowBox[{"v", ",", 
              FractionBox["\"\<Kilometers\>\"", "\"\<Seconds\>\""]}], "]"}], 
            "]"}], ",", "\"\<SolarMass\>\""}], "]"}], " ", "massScale"}]}], 
       "}"}], "/.", "\[VeryThinSpace]", "params"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "0", ",", "100"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Directive", "[", 
        RowBox[{"Red", ",", "Thick"}], "]"}], "}"}]}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", 
     RowBox[{"MaxRecursion", "->", "4"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"fundamentalPlaneFigure", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fundamentalPlane", ",", "maximumMassCurve"}], "}"}], ",", 
    RowBox[{"ViewPoint", "\[Rule]", 
