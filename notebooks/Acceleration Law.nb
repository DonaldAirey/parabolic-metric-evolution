Cell[TextData[{
 "Figure 2. Log--log plot of baryonic mass ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["M", "TI"], 
        StyleBox["b", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$M_b$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6fe343a3-a6ae-1e42-bd16-8726fbc16aac"],
 " versus outer rotation speed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$v$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14edcb68-92c9-644e-8ee3-9d428e0705a7"],
 " for the SPARC galaxy sample. Black circles show the observed galaxies. The \
solid red line shows the circular-orbit envelope evaluated at the best-fit \
acceleration, demonstrating consistency with the observed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["v", "TI"], "4"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$M \\propto v^4$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a7f48b6-8bf6-e24d-98f3-06a4a44ecdb3"],
 " scaling."
}], "Text",
 CellChangeTimes->{{3.9766397454337826`*^9, 3.976639846803047*^9}, {
   3.976640139558981*^9, 3.97664014585009*^9}, 3.9769078922876663`*^9, {
