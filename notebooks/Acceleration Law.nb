Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["M", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["r", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["v", "TI"], "2"], "-", "2", 
            StyleBox["A", "TI"], 
            StyleBox["r", "TI"]}], 
          StyleBox["G", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{dM}{dr} = \\frac{v^2 - 2 A r}{G}", "state" -> "Boxes"|>,
