Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"aLogBest", "=", 
   RowBox[{"aLog", "/.", " ", 
    RowBox[{"minimum", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"h", "=", "1*^-4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d2", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"chiSquareLogFromLogA", "[", 
       RowBox[{"aLogBest", "+", "h"}], "]"}], "-", 
      RowBox[{"2", "*", 
       RowBox[{"chiSquareLogFromLogA", "[", "aLogBest", "]"}]}], "+", 
      RowBox[{"chiSquareLogFromLogA", "[", 
       RowBox[{"aLogBest", "-", "h"}], "]"}]}], ")"}], "/", 
    RowBox[{"h", "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmaLogA", "=", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", "d2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aLow", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{
     RowBox[{"10.", "^", 
      RowBox[{"(", 
       RowBox[{"aLogBest", "-", "sigmaLogA"}], ")"}]}], ",", 
     RowBox[{"\"\<Meters\>\"", "/", 
      RowBox[{"\"\<Seconds\>\"", "^", "2"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aHigh", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{
     RowBox[{"10.", "^", 
      RowBox[{"(", 
       RowBox[{"aLogBest", "+", "sigmaLogA"}], ")"}]}], ",", 
     RowBox[{"\"\<Meters\>\"", "/", 
      RowBox[{"\"\<Seconds\>\"", "^", "2"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"deltaA", "=", 
  RowBox[{"accelerationSI", "*", "sigmaLogA", "*", 
   RowBox[{"Log", "[", "10", "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.989150170934429*^9, 3.989150170943964*^9}, {
  3.989150205804577*^9, 3.989150206640972*^9}, {3.9891503462022896`*^9, 
  3.989150352440281*^9}, {3.989150467398199*^9, 
