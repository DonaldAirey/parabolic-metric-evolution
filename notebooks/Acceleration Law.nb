 RowBox[{
  RowBox[{
   RowBox[{"A", " ", "r"}], "+", 
   FractionBox[
    RowBox[{"G", " ", 
     RowBox[{"M", "[", "r", "]"}]}], "r"]}], "\[Equal]", 
  SuperscriptBox["v", "2"]}]], "Output",
 CellChangeTimes->{3.9868208028885593`*^9, 3.989149847886278*^9},
 CellLabel->"Out[73]=",ExpressionUUID->"c40bdbbb-74ae-6c4e-9dcf-e314d2b2330e"]
}, Open  ]],

